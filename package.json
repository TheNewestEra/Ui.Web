    "@angular/router": "^20.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@thenewestera/accounts-ng": "^1.0.2",
    "@thenewestera/browse-ng": "^1.0.1",
    "@thenewestera/friends-ng": "^1.0.1",
